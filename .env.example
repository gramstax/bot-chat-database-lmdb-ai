# DB Chat — Gramstax bot (copy to .env and fill in with your REAL tokens — never commit .env)
# Telegram Bot Token (from @BotFather)
BOT_TOKEN=

# Bot Deployment Mode: polling | webhook | serverless
BOT_DEPLOY=polling
# BOT_WEBHOOK_URL=
# BOT_WEBHOOK_SECRET=

# Cache session
CACHE_SESSION_STORE=memory
CACHE_SESSION_TTL=14400000
CACHE_SESSION_NAMESPACE=s

# LMDB database path (demo dataset is seeded here on first run)
DB_PATH="./data"

# OpenAI — AI answers (default model gpt-4o-mini).
# Empty = the bot still runs in mock mode (deterministic answers from the real LMDB dataset),
# UNLESS OPENAI_BASE_URL points at a custom provider (see below).
OPENAI_API_KEY=

# OpenAI-compatible API base URL (default https://api.openai.com/v1).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model name for the chat API (default gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini

# Free example — Pollinations (no key needed, model "openai"):
# OPENAI_BASE_URL=https://text.pollinations.ai/openai
# OPENAI_MODEL=openai

# AllowList: Telegram IDs allowed to use the bot, comma-separated. Empty = everyone allowed (dev mode).
DBCHAT_ALLOWED_IDS=

# Mock AI mode (1 = force mock answers even when OPENAI_API_KEY is set; used by e2e).
DBCHAT_MOCK_AI=
